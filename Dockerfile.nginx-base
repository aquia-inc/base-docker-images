# The runtime image, named once so the builder can read its exact nginx
# version. Keep this digest identical to the final FROM below (Renovate bumps
# both together).
FROM cgr.dev/chainguard/nginx:latest@sha256:f5bfac85024ea2d7c16a28ac21e985c6d19a20a60ae74838f056297d44467525 AS runtime

# Using the custom NGINX image from chainguard
FROM cgr.dev/chainguard/nginx:latest-dev@sha256:3313b8400eb5278c193ac72d28803eeb27631f7fc1a42c0841cf68d5685a0946 AS builder

# Switching to root user for package installation
USER root

# CACHEBUST busts the apk layer cache each run so daily rebuilds pick up package updates
ARG CACHEBUST=unset
# Installing required packages for building NGINX
# Relax the exact "pkg=version" pins in /etc/apk/world so "apk upgrade" actually
# applies security updates (the solver otherwise honours the pin and no-ops). The
# "=[0-9]" anchor leaves fuzzy "=~" pins alone.
RUN echo "cachebust=${CACHEBUST}" && \
    sed -i -E 's/=[0-9].*$//' /etc/apk/world && \
    apk update && apk upgrade --no-cache && \
    apk --no-cache add -u perl wget build-base pcre-dev zlib-dev curl openssl-dev

# headers-more-nginx-module release
# https://github.com/openresty/headers-more-nginx-module/?tab=readme-ov-file#compatibility
ARG MORE_HEADERS_VERSION=0.40

WORKDIR /usr/src/

# A dynamic module only loads into the exact nginx version it was compiled
# against ("module ... version 1029001 instead of 1031006"). The version is
# therefore read from the runtime image's own nginx binary rather than pinned
# here: a pinned source version silently falls behind every time the runtime
# base is bumped, and the module then fails to load at startup.
COPY --from=runtime /usr/sbin/nginx /tmp/runtime-nginx
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]
RUN NGINX_VERSION="$(/tmp/runtime-nginx -v 2>&1 | sed -n 's#^nginx version: nginx/##p')" && \
    test -n "$NGINX_VERSION" && \
    echo "Building headers-more ${MORE_HEADERS_VERSION} against runtime nginx ${NGINX_VERSION}" && \
    wget -nv "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" -O nginx.tar.gz && \
    wget -nv "https://github.com/openresty/headers-more-nginx-module/archive/v${MORE_HEADERS_VERSION}.tar.gz" -O extra_module.tar.gz && \
    rm -f /tmp/runtime-nginx

# Make dirs for nginx and extract sources
RUN mkdir -p /usr/src/nginx /usr/src/extra_module /var/log/nginx /etc/nginx/conf.d /var/cache/nginx /var/lib/nginx/modules && chown -R nginx:nginx /var/lib/nginx/ && \
	tar -xzf nginx.tar.gz -C /usr/src/nginx --strip-components=1 && \
	tar -xzf extra_module.tar.gz -C /usr/src/extra_module --strip-components=1

# Compile and install NGINX with additional module
WORKDIR /usr/src/nginx
RUN ./configure --prefix=/usr/local/nginx \
                --with-compat \
                --add-dynamic-module=/usr/src/extra_module && \
    make -j$(($(nproc)/2)) modules && \
    make -j$(($(nproc)/2)) install

# Clean up (absolute paths avoid a 'RUN cd', DS013)
RUN rm -rf /usr/src/nginx /usr/src/nginx.tar.gz /usr/src/extra_module /usr/src/extra_module.tar.gz

# Switch back to non-root user
USER nginx

# Set the shell for subsequent commands
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]

# Start the second stage of the Dockerfile
FROM cgr.dev/chainguard/nginx:latest@sha256:f5bfac85024ea2d7c16a28ac21e985c6d19a20a60ae74838f056297d44467525

# Copy compiled modules only if the directory exists
COPY --from=builder /usr/local/nginx/modules/*.so /var/lib/nginx/modules/

# Set the user for subsequent commands
USER nginx

# Copy NGINX configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Fail the build if the shipped configuration does not load, which includes the
# headers-more module loading into this nginx. Exec form: this image has no
# shell.
RUN ["/usr/sbin/nginx", "-t"]

# Exec form for the same reason: the shell form ("CMD nginx -t || exit 1")
# needs /bin/sh, which this image does not have, so it could never succeed.
HEALTHCHECK --interval=30s --timeout=3s CMD ["/usr/sbin/nginx", "-t"]

# End of Dockerfile
