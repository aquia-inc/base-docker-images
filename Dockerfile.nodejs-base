FROM cgr.dev/chainguard/wolfi-base:latest@sha256:be019c1c74fe69204a42c4e10bc4d886a49bf5403ffa74374ef7baa408fc9a26 AS builder

ARG NODE_VERSION='nodejs~=24'
# CACHEBUST busts the apk layer cache each run so daily rebuilds pick up package updates
ARG CACHEBUST=unset
# Install Node.js, npm and Yarn
# Relax the exact "pkg=version" pins in /etc/apk/world so "apk upgrade" actually
# applies security updates (the solver otherwise honours the pin and no-ops). The
# "=[0-9]" anchor leaves fuzzy "=~" pins (e.g. nodejs=~24) alone.
# The upgrade-by-name pipeline below sets pipefail inline (busybox ash supports
# it); hadolint only recognises pipefail set by SHELL, and a SHELL change here
# would also apply to the later RUNs.
# hadolint ignore=DL4006,SC3040
RUN echo "cachebust=${CACHEBUST}" && \
    sed -i -E 's/=[0-9].*$//' /etc/apk/world && \
    apk update && apk upgrade --no-cache && \
    apk add --no-cache ${NODE_VERSION} yarn npm && \
    # Upgrade by name every package still older than the repository offers (the
    # publish gate's freshness list): a plain "apk upgrade" can leave a package
    # pulled in by "apk add" behind, as libpng 1.6.59-r0 did when Wolfi split it.
    apk update && \
    set -o pipefail && apk version -l '<' | tail -n +2 | awk '{print $1}' \
        | sed -E 's/-[0-9][^-]*-r[0-9]+$//' \
        | xargs -r apk add --no-cache --upgrade

# Extract Node.js version and save to file
SHELL ["/bin/ash", "-o", "pipefail", "-c"]
RUN node --version | awk -F'v' '{print $2}' | tr -d '\n' > /tmp/temp_node_version.txt

# Create symbolic link to match the installed Node.js version
RUN NODE_VERSION=$(cat /tmp/temp_node_version.txt) && \
    mkdir -p /usr/local/nvm/versions/node && \
    ln -s "/usr/local/nvm/versions/node/v${NODE_VERSION}/" /usr/local/nvm/versions/node/current

# Save Node.js version
SHELL ["/bin/ash", "-o", "pipefail", "-c"]
RUN NODE_VERSION=$(node --version | sed 's/v//') && \
    echo "nodejs_major_tag=$(echo $NODE_VERSION | cut -d'.' -f1)" > /tmp/versions.txt && \
    echo "nodejs_minor_tag=$(echo $NODE_VERSION | cut -d'.' -f1-2)" >> /tmp/versions.txt && \
    echo "nodejs=$NODE_VERSION" >> /tmp/versions.txt

RUN cat /tmp/versions.txt

USER nobody
