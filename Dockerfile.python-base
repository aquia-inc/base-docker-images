FROM cgr.dev/chainguard/wolfi-base:latest@sha256:08df5982c3d27e70a4ce1607e3bb9af09d746f8722cf135a7694afef879fc5a2 AS builder

# CACHEBUST busts the apk layer cache each run so daily rebuilds pick up package updates
ARG CACHEBUST=unset
# The base image records exact "pkg=version" constraints in /etc/apk/world, which makes a
# plain "apk upgrade" a no-op for those packages: the solver honours the pin and leaves them
# behind. Relaxing the exact pins to bare names first lets security updates actually apply.
# The "=[0-9]" anchor deliberately leaves fuzzy "=~" pins alone. pip is bootstrapped from the
# retained ensurepip wheel (py3-pip-wheel) into the user dir, so no system pip/_vendor ships.
RUN echo "cachebust=${CACHEBUST}" && \
    sed -i -E 's/=[0-9].*$//' /etc/apk/world && \
    apk update && apk upgrade --no-cache && \
    apk add --no-cache --upgrade python-3.13 py3-pip-wheel

# local install to /home/nonroot/.local/bin
USER nonroot
ENV POETRY_HOME=/home/nonroot \
    PATH=$PATH:/home/nonroot/.local/bin \
    PYTHONPATH=/home/nonroot/.local/lib/python3/site-packages

RUN python3 -m ensurepip --user --upgrade && \
    python3 -m pip install --no-cache-dir --upgrade --user -v pip poetry cryptography virtualenv

# Raise pip's own bundled dependencies to their fixed versions:
# msgpack 1.1.2 -> 1.2.1 (GHSA-6v7p-g79w-8964) and pkg_resources removed
# (CVE-2025-47273, CVE-2026-59890 - setuptools dropped it in 82.0.0).
COPY --chown=nonroot:nonroot scripts/harden-pip-vendor.py /tmp/harden-pip-vendor.py
RUN python3 /tmp/harden-pip-vendor.py && rm -f /tmp/harden-pip-vendor.py

# Remove virtualenv's superseded seed wheels and correct its declared
# inventory. virtualenv keeps one pip/setuptools pair per supported Python
# version, so the copies for older interpreters stay at their original
# vulnerable versions - currently pip 26.0.1 (CVE-2026-13346, CVE-2026-3219,
# CVE-2026-6357, CVE-2026-8643) and setuptools 82.0.1 (CVE-2026-59890).
#
# There is no installable fix: virtualenv 21.9.1 still bundles them, and
# virtualenv cannot be dropped because poetry imports it. Deleting the wheels
# alone is not enough either, because virtualenv ships its own CycloneDX SBOM
# and RECORD that scanners read as the inventory. See the script header.
COPY --chown=nonroot:nonroot scripts/harden-virtualenv-seeds.py /tmp/harden-virtualenv-seeds.py
RUN python3 /tmp/harden-virtualenv-seeds.py && rm -f /tmp/harden-virtualenv-seeds.py

# Poetry sets default max workers to num of cpu-cores + 4, but pip max connection pool
# is set at 10 and will discard any above that when installing dependencies
RUN poetry config installer.max-workers 10

# create symlink for correct PYTHONPATH for poetry
SHELL ["/bin/ash", "-o", "pipefail", "-c"]
# The leading "s/+.*$//" strips CPython's snapshot suffix. Wolfi moved the
# python-3.13 package to a git snapshot (3.13.15_git20260912-r0), so
# "python3 --version" now prints "Python 3.13.15+". This value is used as a
# Docker tag, and "+" is not a legal tag character, which made the
# multi-arch manifest step fail with "invalid reference format" on
# python-base:3.13.15+. It is stripped first so the trailing-component
# match below still anchors correctly.
RUN python3 --version 2>&1 | awk -F' ' '{print $2}' | tr -d '\n' | sed 's/+.*$//' | cut -d. -f1-2 > /tmp/python_minor_version.txt && \
PY_VERSION=$(cat /tmp/python_minor_version.txt) && \
ln -s "/home/nonroot/.local/lib/python${PY_VERSION}" /home/nonroot/.local/lib/python3

# save Python, pip, and Poetry versions
RUN echo "python_major_tag=$(python3 --version 2>&1 | awk -F' ' '{split($2, a, "."); print a[1]}' | tr -d '\n')" > /tmp/versions.txt  && \
echo "python_minor_tag=$(cat /tmp/python_minor_version.txt)" >> /tmp/versions.txt && \
echo "python=$(python3 --version 2>&1 | awk -F' ' '{print $2}' | tr -d '\n')" >> /tmp/versions.txt && \
echo "pip=$(pip3 --version 2>&1 | awk -F' ' '{print $2}' | tr -d '\n')" >> /tmp/versions.txt && \
echo "poetry=$(poetry --version 2>&1 | awk -F 'version |\\)' '{print $2}' | sed 's/)$//')" >> /tmp/versions.txt

USER root
RUN apk del libcurl-openssl4 curl

USER nonroot
RUN python3 --version


